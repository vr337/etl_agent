# ============ PostgreSQL ============
ETL_AGENT_POSTGRES_USER=etl_agent
ETL_AGENT_POSTGRES_PASSWORD=CHANGE_ME
ETL_AGENT_POSTGRES_DB=etl_agent
ETL_AGENT_POSTGRES_PORT=5432

# ============ Redis ============
ETL_AGENT_REDIS_PASSWORD=CHANGE_ME
ETL_AGENT_REDIS_PORT=6379

# ============ 应用连接串 ============
ETL_AGENT_DATABASE_URL=postgresql+asyncpg://etl_agent:CHANGE_ME@localhost:5432/etl_agent
ETL_AGENT_CHECKPOINT_DATABASE_URL=postgresql+asyncpg://etl_agent:CHANGE_ME@localhost:5432/etl_checkpoint
ETL_AGENT_REDIS_URL=redis://:CHANGE_ME@localhost:6379/0

# ============ 认证（S2：M-A 双模式） ============
# ENV：dev | staging | prod（prod 强制 trusted-gateway + 下列三项，缺失拒绝启动，AC-11）
ETL_AGENT_ENV=dev
# AUTH_MODE：dev-header（仅非生产，X-Actor-ID 头声明身份）| trusted-gateway（HMAC-SHA256 验签）
ETL_AGENT_AUTH_MODE=dev-header
# trusted-gateway 必填：HMAC 密钥 ≥32 字节
ETL_AGENT_GATEWAY_HMAC_SECRET=CHANGE_ME_MIN_32_BYTES
# Ed25519 公钥（S6 Capability 验签用；prod 启动必填）
ETL_AGENT_HARNESS_PUBLIC_KEYS=
# 工作区初始化（FR-01）：启用时 Token 必须 ≥32 字节
ETL_AGENT_BOOTSTRAP_ENABLED=true
ETL_AGENT_BOOTSTRAP_TOKEN=CHANGE_ME_MIN_32_BYTES

# ============ SecretProvider（S3：M-C 双模式，FR-06 / ADR-05） ============
# fernet-db | vault-kv-v2；vault-kv-v2 时 VAULT_ADDR 必填（Q5/S-Q7 待定）
ETL_AGENT_SECRET_PROVIDER=fernet-db
# Fernet key（base64，32 字节）：
#   生成：uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ETL_AGENT_FERNET_KEY=CHANGE_ME_GENERATE_FERNET_KEY
# 主密钥版本号（密文自带 key_version；轮换主密钥时递增并把旧钥填入 FERNET_PREVIOUS_KEYS）
ETL_AGENT_FERNET_KEY_VERSION=1
# 历史主密钥（逗号分隔；旧密文在密钥轮换后仍可读）
ETL_AGENT_FERNET_PREVIOUS_KEYS=
# Vault（Q5/S-Q7 待定，未部署时保持为空并选用 fernet-db）
ETL_AGENT_VAULT_ADDR=
ETL_AGENT_VAULT_TOKEN=
# 凭据告警 Webhook（FR-10；未配置则扫描只生成预警记录、不投递）
ETL_AGENT_ALERT_WEBHOOK_URL=
