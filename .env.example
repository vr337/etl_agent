# ============ PostgreSQL ============
ETL_AGENT_POSTGRES_USER=etl_agent
ETL_AGENT_POSTGRES_PASSWORD=CHANGE_ME
ETL_AGENT_POSTGRES_DB=etl_agent
ETL_AGENT_POSTGRES_PORT=5432

# ============ Redis ============
ETL_AGENT_REDIS_PASSWORD=CHANGE_ME
ETL_AGENT_REDIS_PORT=6379

# ============ 应用连接串 ============
ETL_AGENT_DATABASE_URL=postgresql+asyncpg://etl_agent:CHANGE_ME@localhost:5432/etl_agent
ETL_AGENT_CHECKPOINT_DATABASE_URL=postgresql+asyncpg://etl_agent:CHANGE_ME@localhost:5432/etl_checkpoint
ETL_AGENT_REDIS_URL=redis://:CHANGE_ME@localhost:6379/0

# ============ 认证（S2：M-A 双模式） ============
# ENV：dev | staging | prod（prod 强制 trusted-gateway + 下列三项，缺失拒绝启动，AC-11）
ETL_AGENT_ENV=dev
# AUTH_MODE：dev-header（仅非生产，X-Actor-ID 头声明身份）| trusted-gateway（HMAC-SHA256 验签）
ETL_AGENT_AUTH_MODE=dev-header
# trusted-gateway 必填：HMAC 密钥 ≥32 字节
ETL_AGENT_GATEWAY_HMAC_SECRET=CHANGE_ME_MIN_32_BYTES
# Ed25519 公钥（S6 Capability 验签用；prod 启动必填）
ETL_AGENT_HARNESS_PUBLIC_KEYS=
# 工作区初始化（FR-01）：启用时 Token 必须 ≥32 字节
ETL_AGENT_BOOTSTRAP_ENABLED=true
ETL_AGENT_BOOTSTRAP_TOKEN=CHANGE_ME_MIN_32_BYTES

# ============ SecretProvider（S3：M-C 双模式，FR-06 / ADR-05） ============
# fernet-db | vault-kv-v2；vault-kv-v2 时 VAULT_ADDR 必填（Q5/S-Q7 待定）
ETL_AGENT_SECRET_PROVIDER=fernet-db
# Fernet key（base64，32 字节）：
#   生成：uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ETL_AGENT_FERNET_KEY=CHANGE_ME_GENERATE_FERNET_KEY
# 主密钥版本号（密文自带 key_version；轮换主密钥时递增并把旧钥填入 FERNET_PREVIOUS_KEYS）
ETL_AGENT_FERNET_KEY_VERSION=1
# 历史主密钥（逗号分隔；旧密文在密钥轮换后仍可读）
ETL_AGENT_FERNET_PREVIOUS_KEYS=
# Vault（Q5/S-Q7 待定，未部署时保持为空并选用 fernet-db）
ETL_AGENT_VAULT_ADDR=
ETL_AGENT_VAULT_TOKEN=
# 凭据告警 Webhook（FR-10；未配置则扫描只生成预警记录、不投递）
ETL_AGENT_ALERT_WEBHOOK_URL=

# ============ M-D 元数据探查（S4：FR-12） ============
# 单次 Profile 的采样行数上限默认值（合法区间 1–100，越界由 profiles 域返回 422）
ETL_AGENT_PROFILE_SAMPLE_LIMIT_DEFAULT=100

# ============ M-E 文件资产（S4：FR-13） ============
# 文件资产根目录（引擎只读挂载路径；S7 起 SeaTunnel 容器挂载到 /data/file-assets:ro）
ETL_AGENT_FILE_ASSET_ROOT=D:/Documents/Docker/volume/app/etl_agent/file_assets
# 单文件上限：25 MiB / 100,000 行（超限返回 422）
ETL_AGENT_FILE_ASSET_MAX_SIZE_MB=25
ETL_AGENT_FILE_ASSET_MAX_ROWS=100000

# ============ M-F 生成引擎 · LLM Provider（S5：FR-18/21/24；T-LLM-01） ============
# openai | deepseek | doubao | kimi | zhipu | custom | mock
# mock 仅用于测试与无 Key 环境；生产（ENV=prod）禁止 mock，启动即拒绝（S5 提示词 11.2）
ETL_AGENT_LLM_PROVIDER=mock
# 选真实 Provider 时三项必填（OpenAI 兼容端点）。
# custom 走任意兼容端点，常见 BASE_URL / MODEL：
#   硅基流动    https://api.siliconflow.cn/v1     Qwen/Qwen2.5-72B-Instruct
#   DeepSeek    https://api.deepseek.com/v1       deepseek-chat
#   OpenRouter  https://openrouter.ai/api/v1      deepseek/deepseek-chat
#   本地 OneAPI http://127.0.0.1:3000/v1          按渠道实际型号
ETL_AGENT_LLM_API_KEY=
ETL_AGENT_LLM_BASE_URL=https://api.deepseek.com/v1
ETL_AGENT_LLM_MODEL=deepseek-chat
# 单次生成请求超时（秒）。T-LLM-01 定为 120（原 180 属遗留）
ETL_AGENT_LLM_TIMEOUT_SECONDS=120
# 有限修复候选预算（含初始候选，1–3；FR-21 硬上限，越界拒绝启动）
# 3 = 初始 1 次 + 最多 2 次「门禁反馈 → 重新生成」的修复重试
ETL_AGENT_LLM_MAX_CANDIDATES=3

# ============ M-H / M-J 版本与 Harness 内核（S6：FR-26~35） ============
# Ed25519 私钥（32 字节 hex，仅策略包签名脚本使用，控制面不持有）：
#   生成：uv run python -c "from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey; print(Ed25519PrivateKey.generate().private_bytes_raw().hex())"
# 配套公钥（32 字节 raw，hex）需同时填入上面 ETL_AGENT_HARNESS_PUBLIC_KEYS（逗号分隔可配多个）
ETL_AGENT_HARNESS_SIGNING_KEY_HEX=
# 签名策略包（清单 + 分离签名）：缺失 / 篡改 / 验签失败 → 拒绝启动（FR-30）
#   生成：ETL_AGENT_HARNESS_SIGNING_KEY_HEX=<私钥> uv run python scripts/gen_policy_package.py
ETL_AGENT_POLICY_PACKAGE_PATH=./configs/policy/harness-v2-20260808.json
ETL_AGENT_POLICY_PACKAGE_SIGNATURE_PATH=./configs/policy/harness-v2-20260808.sig
# Capability TTL（秒，30–900 默认 300；越界拒绝启动，FR-33 / SPEC 6.2）
ETL_AGENT_HARNESS_CAPABILITY_TTL_SECONDS=300
# 准备单 TTL（秒，300–604800 默认 86400；越界拒绝启动，FR-31 / SPEC 6.2）
ETL_AGENT_HARNESS_PREPARATION_TTL_SECONDS=86400

# ============ M-J/M-K 执行调度与数据面（S7：FR-38/40/41） ============
# SeaTunnel Zeta 引擎地址（Worker 执行面唯一引擎出口；compose 内为 http://seatunnel:8080）
ETL_AGENT_SEATUNNEL_URL=http://localhost:8080
# REST 提交超时（秒）与 CLI --check 超时（秒）
ETL_AGENT_SEATUNNEL_SUBMIT_TIMEOUT_SECONDS=30
ETL_AGENT_SEATUNNEL_CHECK_TIMEOUT_SECONDS=120
# Celery Worker 心跳 10s 上报 / 35s 判失活（FR-38；SPEC 8 高可用行）
ETL_AGENT_WORKER_HEARTBEAT_INTERVAL_SECONDS=10
ETL_AGENT_WORKER_INACTIVE_SECONDS=35
# Outbox 扫描 2s（FR-35 / ADR-06）；最大重试次数与指数退避基数（秒）、领取锁窗口（秒）
ETL_AGENT_OUTBOX_SCAN_INTERVAL_SECONDS=2
ETL_AGENT_OUTBOX_MAX_RETRIES=5
ETL_AGENT_OUTBOX_RETRY_BACKOFF_SECONDS=5
ETL_AGENT_OUTBOX_LOCK_SECONDS=30
# 调度扫描 30s / 凭据告警扫描 3600s（FR-40 / FR-10；SPEC 4.3 Beat 行）
ETL_AGENT_SCHEDULER_SCAN_INTERVAL_SECONDS=30
ETL_AGENT_CREDENTIAL_SCAN_INTERVAL_SECONDS=3600
# misfire 宽限 120s（FR-40）
ETL_AGENT_SCHEDULE_MISFIRE_GRACE_SECONDS=120
# RUNNING 执行推进：引擎查询间隔（秒）与停滞告警阈值（秒）
ETL_AGENT_EXECUTION_POLL_INTERVAL_SECONDS=2
ETL_AGENT_EXECUTION_POLL_MAX_WAIT_SECONDS=300
# Capability 令牌交接通道（Redis 单次读；令牌本体不落业务库，FR-33 / AC-02）
ETL_AGENT_CAPABILITY_HANDOFF_KEY_PREFIX=harness:capability
ETL_AGENT_CAPABILITY_HANDOFF_TTL_SECONDS=300

# ============ M-O 可观测（S7：FR-59/60） ============
# OTel 开关：false 时零成本（不建 Provider / 不注册埋点 / 不建导出器）
ETL_AGENT_OTEL_ENABLED=false
# 启用时必填 OTLP 端点（如 http://otel-collector:4317）；未填且启用则拒绝启动
ETL_AGENT_OTEL_EXPORTER_OTLP_ENDPOINT=
# 导出超时 10s（不得阻塞请求路径）
ETL_AGENT_OTEL_EXPORT_TIMEOUT_SECONDS=10

# ============ M-K/M-L 质量发布与运行时监督（S8：FR-43~48） ============
# 监督快照周期 10s（与 Worker 心跳同频；FR-45 / 提示词 §8.5）
ETL_AGENT_SUPERVISION_INTERVAL_SECONDS=10
# 回滚制品到期清理扫描 3600s（FR-48；与凭据告警同频）
ETL_AGENT_ROLLBACK_CLEANUP_SCAN_INTERVAL_SECONDS=3600
# 外部减损动作独立重试预算（次数，默认 3；提示词 §8.9）
ETL_AGENT_EXTERNAL_MITIGATION_MAX_ATTEMPTS=3
# 回滚制品保留期（天，默认 7；仅可收紧不可放宽，FR-48）
ETL_AGENT_ROLLBACK_RETENTION_DAYS=7
# 回滚制品容量预警阈值（件数，默认 20；仅可收紧不可放宽，FR-48）
ETL_AGENT_ROLLBACK_CAPACITY_WARN_THRESHOLD=20


# ============ M-N/M-M 审计证据与评测安全进化（S9：FR-36/50/51/52） ============
# 证据账本 Ed25519 检查点：每 N 个事件打一次（默认 100；FR-36 / 提示词 §8.1）
ETL_AGENT_EVIDENCE_CHECKPOINT_INTERVAL_EVENTS=100
# 证据账本 Ed25519 检查点：每 T 秒打一次（默认 300；与事件数任一满足即打）
ETL_AGENT_EVIDENCE_CHECKPOINT_INTERVAL_SECONDS=300
# Benchmark 套件根目录与默认套件版本（FR-50：benchmarks/harness-v2/v1）
ETL_AGENT_BENCHMARK_SUITE_ROOT=benchmarks
ETL_AGENT_BENCHMARK_DEFAULT_SUITE_ID=harness-v2
ETL_AGENT_BENCHMARK_DEFAULT_VERSION=v1
# 非 LLM 决策路径 P95 基准（毫秒，默认 20；SPEC 8「性能」）
ETL_AGENT_BENCHMARK_NON_LLM_P95_BASELINE_MS=20
# 受控发布小流量晋升允许的异常率上限（默认 0.05；超阈值拒绝晋升，FR-52）
ETL_AGENT_SAFETY_PROMOTION_ANOMALY_THRESHOLD=0.05
