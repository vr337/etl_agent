FROM python:3.12-slim

WORKDIR /app

# 装 uv
COPY --from=ghcr.io/astral-sh/uv:0.4 /uv /usr/local/bin/uv

# 先拷贝依赖清单（利用缓存）
COPY pyproject.toml uv.lock ./

# 装依赖
RUN uv sync --frozen --extra dev

# 拷贝源码
COPY src/ ./src/
COPY alembic/ ./alembic/
COPY alembic.ini ./
# 占位符契约（FR-68：Worker 凭据物化的唯一事实源，相对路径 configs/... 按
# WORKDIR /app 解析）——漏 COPY 时容器内该文件不存在，执行必败于
# CredentialMaterializationFailed（S10 联调实证，2026-10-16）
COPY configs/ ./configs/

ENV PYTHONPATH=/app/src
ENV PATH="/app/.venv/bin:${PATH}"

EXPOSE 8000

CMD ["uv", "run", "uvicorn", "etl_agent.main:app", "--host", "0.0.0.0", "--port", "8000"]