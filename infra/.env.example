# ============================================================
# etl_agent 环境变量模板（T-LLM-01）
# ============================================================
# 用法：cp infra/.env.example infra/.env 后按需填写。
# 红线：infra/.env 含真实凭据，**永不入库**（.gitignore 已忽略）；
#       本模板只放占位符，禁止写入任何真实 key / token / 口令。
# ============================================================

# ---- LLM Provider（T-LLM-01 核心）----
# mock        = 固定响应，仅测试/无 Key 环境；ENV=prod 会被 validate_llm 拒绝启动
# openai      = OpenAI 官方
# deepseek    = 深度求索
# doubao      = 火山方舟
# kimi        = 月之暗面
# zhipu       = 智谱
# custom      = 任意 OpenAI 兼容端点（硅基流动 / OneAPI / OpenRouter 等）
# 以上非 mock 者共用同一套 OpenAI 兼容协议，差异只在 BASE_URL / MODEL
ETL_AGENT_LLM_PROVIDER=custom

# OpenAI 兼容端点（含 /v1 前缀）。常见取值：
#   硅基流动   https://api.siliconflow.cn/v1
#   DeepSeek   https://api.deepseek.com/v1
#   OpenRouter https://openrouter.ai/api/v1
#   本地 OneAPI http://127.0.0.1:3000/v1
ETL_AGENT_LLM_BASE_URL=https://api.siliconflow.cn/v1

# 中转平台的 sk-xxx（真实值只写进 infra/.env，不要提交）
ETL_AGENT_LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 模型名（按平台实际可用型号填）：
#   硅基流动   Qwen/Qwen2.5-72B-Instruct
#   DeepSeek   deepseek-chat
#   OpenRouter deepseek/deepseek-chat
ETL_AGENT_LLM_MODEL=Qwen/Qwen2.5-72B-Instruct

# 单次生成请求超时（秒）。T-LLM-01 定为 120
ETL_AGENT_LLM_TIMEOUT_SECONDS=120

# 候选预算（含初始候选，取值 1–3）。
# 3 = 初始 1 次 + 最多 2 次「门禁反馈 → 重新生成」的修复重试（FR-21 硬上限）
ETL_AGENT_LLM_MAX_CANDIDATES=3

# ---- 以下为本地开发默认值，通常无需改动 ----
ETL_AGENT_POSTGRES_USER=etl_agent
ETL_AGENT_POSTGRES_PASSWORD=<本地开发口令>
ETL_AGENT_POSTGRES_DB=etl_agent
ETL_AGENT_POSTGRES_PORT=5432
ETL_AGENT_REDIS_PORT=6379

# 凭据加密（fernet-db）：用 `python -c "from cryptography.fernet import Fernet;
# print(Fernet.generate_key().decode())"` 生成，**每个环境独立**，勿复用
ETL_AGENT_SECRET_PROVIDER=fernet-db
ETL_AGENT_FERNET_KEY=<32 字节 base64 的 Fernet key>

# Bootstrap 一次性建号（首次启动用；生产建议关闭）
ETL_AGENT_BOOTSTRAP_ENABLED=true
ETL_AGENT_BOOTSTRAP_TOKEN=<随机 32 字节 hex>
