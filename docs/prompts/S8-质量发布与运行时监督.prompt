## 十、验收命令（DoD 必须附输出）

```powershell
cd D:\Desktop\code\etl_agent

# 1. 前置检查
git log --oneline -3
docker compose -f infra\docker-compose.yml ps

# 2. 同步依赖
uv sync --extra dev

# 3. 迁移（S8 不新增；S1 的 4 张 S8 表应在）
uv run alembic upgrade head
uv run alembic downgrade base
uv run alembic upgrade head

# 4. 单元测试
uv run pytest tests\supervision\ tests\diagnosis\ tests\rollback\ -v
uv run pytest tests\execution\test_atomic_swap.py tests\execution\test_publish.py -v
uv run pytest tests -q   # 全量回归

# 5. Lint / Type
uv run ruff check src\ tests\
uv run mypy src\etl_agent\supervision\ src\etl_agent\diagnosis\ src\etl_agent\rollback\ src\etl_agent\execution\ src\etl_agent\config.py

# 6. 凭据零明文
Get-ChildItem -Recurse -File -Include "*.py","*.yml","*.yaml","*.ini","*.sql","*.toml" |
  Where-Object { $_.FullName -notmatch "\\\.git\\|\\\.venv\\" } |
  Select-String -Pattern "(password|secret|token)\s*=\s*['\`"][^'\`"]{3,}['\`"]"

# 7. AC-07 专项：原子 Swap + 质量报告
uv run pytest tests\execution\test_atomic_swap.py tests\execution\test_publish.py -v

# 8. AC-08 专项：硬中断 + 诊断 + 回滚
uv run pytest tests\supervision\test_interrupt.py tests\supervision\test_quarantine.py tests\diagnosis\ tests\rollback\ -v

# 9. 监督规则全注册核对
uv run python -c "from etl_agent.supervision.contracts import RULE_IDS; print(RULE_IDS)"
# 期望：6 条规则 ID

# 10. 代码注释抽检
Get-ChildItem -Recurse -File -Path src\etl_agent\ -Include "*.py" |
  Where-Object { $_.Name -ne "__init__.py" } |
  ForEach-Object {
    $head = Get-Content $_.FullName -TotalCount 10 -Raw
    if ($head -notmatch "SPEC 依据" -or $head -notmatch "覆盖 FR" -or $head -notmatch "对应 AC") {
      Write-Output "MISSING HEADER: $($_.FullName)"
    }
  }

# 11. .env 未被修改
Get-Content infra\.env | Select-String "FERNET_KEY|SEATUNNEL_URL"
# 期望：均为人类配置的值
```

