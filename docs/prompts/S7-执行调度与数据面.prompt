| test_error_response_trace_id | 错误响应含 trace_id |
| test_health_worker_summary | `/health` 含 worker 摘要（脱敏） |
| test_health_no_credential_read | `/health` 不主动读凭据 |

## 十、验收命令（DoD 必须附输出）

```powershell
cd D:\Desktop\code\etl_agent

# 1. 前置检查
git log --oneline -3
docker compose -f infra\docker-compose.yml ps

# 2. 同步依赖
uv sync --extra dev

# 3. 迁移（S7 不新增）
uv run alembic upgrade head
uv run alembic downgrade base
uv run alembic upgrade head

# 4. 单元测试
uv run pytest tests\worker\ tests\execution\ tests\scheduling\ tests\observability\ -v
uv run pytest tests -q   # 全量回归

# 5. Lint / Type
uv run ruff check src\ tests\
uv run mypy src\etl_agent\worker\ src\etl_agent\execution\ src\etl_agent\scheduling\ src\etl_agent\observability\ src\etl_agent\config.py

# 6. 凭据零明文
Get-ChildItem -Recurse -File -Include "*.py","*.yml","*.yaml","*.ini","*.sql","*.toml" |
  Where-Object { $_.FullName -notmatch "\\\.git\\|\\\.venv\\" } |
  Select-String -Pattern "(password|secret|token)\s*=\s*['\`"][^'\`"]{3,}['\`"]"

# 7. AC-06 专项：Worker 消费 Outbox
uv run pytest tests\worker\test_consume_outbox.py -v

# 8. 凭据物化契约核对（S6 吸收 5）
Select-String -Path configs\credential_placeholders.yaml -Pattern "SRC_|SINK_|FILE_ASSET_BASE"
# 期望：10 个变量名可见

# 9. 代码注释抽检
Get-ChildItem -Recurse -File -Path src\etl_agent\ -Include "*.py" |
  Where-Object { $_.Name -ne "__init__.py" } |
  ForEach-Object {
    $head = Get-Content $_.FullName -TotalCount 10 -Raw
    if ($head -notmatch "SPEC 依据" -or $head -notmatch "覆盖 FR" -or $head -notmatch "对应 AC") {
      Write-Output "MISSING HEADER: $($_.FullName)"
    }
  }

# 10. .env 未被修改
Get-Content infra\.env | Select-String "SEATUNNEL_URL|FERNET_KEY"
# 期望：均为人类配置的值

# 11. 容器可起（exec profile）
docker compose -f infra\docker-compose.yml --profile exec up -d
docker compose -f infra\docker-compose.yml ps
# 期望：PG + Redis + worker + beat + seatunnel 全 healthy
docker compose -f infra\docker-compose.yml --profile exec down
```

