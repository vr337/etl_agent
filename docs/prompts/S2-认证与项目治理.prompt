## 十一、验收命令（DoD 必须附输出，PowerShell）

```powershell
cd D:\Desktop\code\etl_agent

# 1. 前置检查
git log --oneline -1
docker compose -f infra\docker-compose.yml ps

# 2. 同步依赖
uv sync --extra dev

# 3. 迁移（S2 不新增，但需验证 S1 表仍在）
uv run alembic upgrade head
uv run alembic downgrade base
uv run alembic upgrade head

# 4. 单元测试
uv run pytest tests\auth\ tests\projects\ -v
uv run pytest tests\infrastructure\ -v   # S1 25 个用例必须仍全过

# 5. Lint / Type
uv run ruff check src\ tests\
uv run mypy src\etl_agent\auth\ src\etl_agent\projects\ src\etl_agent\config.py

# 6. 生产启动强制校验（AC-11）
$env:ETL_AGENT_ENV="prod"; $env:ETL_AGENT_AUTH_MODE="dev-header"
uv run python -c "from etl_agent.config import settings; settings.validate_production()"
# 期望：抛异常 / SystemExit
Remove-Item Env:ETL_AGENT_ENV,Env:ETL_AGENT_AUTH_MODE

# 7. Redis Nonce 失败关闭验证（AC-11）
docker stop etl_agent_redis
uv run pytest tests\auth\test_nonce_store.py::test_nonce_redis_unavailable -v
docker start etl_agent_redis

# 8. 凭据零明文核对
Get-ChildItem -Recurse -File -Include "*.py","*.yml","*.yaml","*.ini","*.sql","*.toml" |
  Where-Object { $_.FullName -notmatch "\\\.git\\|\\\.venv\\" } |
  Select-String -Pattern "(password|secret|token)\s*=\s*['\`"][^'\`"]{3,}['\`"]"

# 9. 代码注释合规抽检（DoD-12）
Get-ChildItem -Recurse -File -Path src\etl_agent\ -Include "*.py" |
  Where-Object { $_.Name -ne "__init__.py" } |
  ForEach-Object {
    $head = Get-Content $_.FullName -TotalCount 10 -Raw
    if ($head -notmatch "SPEC 依据" -or $head -notmatch "覆盖 FR" -or $head -notmatch "对应 AC") {
      Write-Output "MISSING HEADER: $($_.FullName)"
    }
  }
# 期望：无 MISSING HEADER 输出
```

