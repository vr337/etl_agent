        - "spec:v1.0.3-Baseline"
        - "ac:AC-02"
      milestone: "etl_agent v1.0 实施"

  - action: update_milestone
    params:
      repo: https://github.com/vr337/etl_agent.git
      milestone: "etl_agent v1.0 实施"
      completed:
        - "T-07 M-D 元数据探查与数据分级"
        - "T-08 M-E 文件资产"
```

