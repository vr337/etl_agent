```powershell
cd D:\Desktop\code\etl_agent

# 1. 前置检查
git log --oneline -5
docker compose -f infra\docker-compose.yml ps

# 2. 同步依赖
uv sync --extra dev

# 3. 迁移（S4 不新增，S1 的 2 张 S4 表应在）
uv run alembic upgrade head
uv run alembic downgrade base
uv run alembic upgrade head

# 4. 单元测试
uv run pytest tests\profiles\ tests\files\ -v
uv run pytest tests\auth\ tests\projects\ tests\infrastructure\ tests\connections\ tests\secrets\ -v   # 回归

# 5. Lint / Type
uv run ruff check src\ tests\
uv run mypy src\etl_agent\profiles\ src\etl_agent\files\ src\etl_agent\config.py

# 6. 凭据零明文核对（AC-02）
Get-ChildItem -Recurse -File -Include "*.py","*.yml","*.yaml","*.ini","*.sql","*.toml" |
  Where-Object { $_.FullName -notmatch "\\\.git\\|\\\.venv\\" } |
  Select-String -Pattern "(password|secret|token)\s*=\s*['\`"][^'\`"]{3,}['\`"]"

# 7. 代码注释合规抽检（DoD-13）
Get-ChildItem -Recurse -File -Path src\etl_agent\ -Include "*.py" |
  Where-Object { $_.Name -ne "__init__.py" } |
  ForEach-Object {
    $head = Get-Content $_.FullName -TotalCount 10 -Raw
    if ($head -notmatch "SPEC 依据" -or $head -notmatch "覆盖 FR" -or $head -notmatch "对应 AC") {
      Write-Output "MISSING HEADER: $($_.FullName)"
    }
  }

# 8. .env 未被修改核对（S4 起强制）
Get-Content infra\.env | Select-String "FERNET_KEY"
# 期望：仍为 S3 时的值，未被 S4 修改

# 9. 无全表 COUNT 核对（FR-12 红线）
Select-String -Path src\etl_agent\profiles\*.py -Pattern "COUNT\(\*\)"
# 期望：无匹配（或仅用于采样子查询的注释说明）
```

