# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# ---- 虚拟环境（uv 管理）----
.venv/
venv/

# ---- 测试 / 类型 / Lint 缓存 ----
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# ---- 环境与凭据（零明文：.env 一律不入库，仅 .env.example 模板）----
.env
.env.*
!.env.example
infra/.env

# ---- IDE / 系统 ----
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# ---- WorkBuddy 会话数据 ----
.workbuddy/
.workbuddy-ai/

# ---- 日志 ----
*.log

# ============================================================
# ---- S10：前端（Vite + Vue）----
# ============================================================
# 依赖目录：体积巨大（含平台二进制），且 node_modules 在 Windows/macOS/Linux
# 上内容不同——入库会造成「克隆即冲突」。**必须**由 `npm ci` 还原。
node_modules/

# 构建产物：可复现产出，不入库（部署用 CI 构建或镜像内构建）。
# 注意：上面的 Python `dist/` 规则是**任意层级**匹配，已覆盖 frontend/dist，
# 此处显式写出仅为可读性——「为什么 dist 不在库里」在这里能一眼看到。
frontend/dist/

# 构建/缓存
frontend/.vite/
frontend/*.tsbuildinfo

# 前端本地环境变量（可能含本地开关；模板 .env.example 可入库）
frontend/.env.local
frontend/.env.*.local

# 测试 / 覆盖率产物
frontend/coverage/

# 注意：`frontend/package-lock.json` **必须入库**——它是依赖树的唯一事实来源，
# 保证 `npm ci` 在所有平台还原同一份依赖（可复现构建）。切勿忽略。

